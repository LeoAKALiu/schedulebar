{
  "description": "ScheduleBar lifecycle capture. Hooks write qualifying turns to the durable local queue and never block Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/schedulebar-mcp\" hook",
            "timeout": 5,
            "statusMessage": "ScheduleBar session"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/schedulebar-mcp\" hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/schedulebar-mcp\" hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
